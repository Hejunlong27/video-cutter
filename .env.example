# docker compose 可选的环境覆盖（默认值已写在 docker-compose.yml 里）
# 用法：cp .env .env.local && docker compose --env-file .env.local up -d

# 对外端口
WEB_PORT=8080

# 上传上限（MB）
MAX_UPLOAD_MB=2048

# 默认片段时长（秒）
DEFAULT_SEGMENT_TIME=10

# 同时处理的切割任务数
MAX_CONCURRENCY=2

# 文件保留时长（小时）
RETENTION_HOURS=24

# 清理扫描间隔（分钟）
CLEANUP_INTERVAL_MINUTES=30
