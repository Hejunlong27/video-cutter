# ---------- 服务 ----------
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=*

# ---------- 存储 ----------
# 容器内默认 /data，本地开发可用 ./storage
STORAGE_ROOT=./storage
# 注意：Prisma 的 SQLite 相对路径是相对 prisma/schema.prisma 所在目录，
# 所以 "file:./dev.db" 实际落到 server/prisma/dev.db
DATABASE_URL="file:./dev.db"

# ---------- 队列 ----------
# auto   = 能连上 Redis 就用 BullMQ，连不上自动降级为进程内调度（默认，推荐）
# redis  = 强制使用 BullMQ + Redis，连不上直接启动失败
# inline = 强制进程内调度，完全不依赖 Redis
QUEUE_DRIVER=auto
REDIS_URL=redis://127.0.0.1:6379

# ---------- FFmpeg ----------
# 容器内 ffmpeg 已在 PATH 中，本地开发请填绝对路径或确保在 PATH
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
FFMPEG_TIMEOUT_MINUTES=60

# ---------- 业务限制 ----------
MAX_UPLOAD_MB=2048
DEFAULT_SEGMENT_TIME=10
MAX_CONCURRENCY=2
RETENTION_HOURS=24
CLEANUP_INTERVAL_MINUTES=30
ALLOWED_EXTENSIONS=mp4,mov,mkv,avi,webm,m4v,flv,ts,mpeg,mpg,wmv
