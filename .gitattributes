# 统一行尾策略
# 仓库内存 LF（跨平台友好），检出时按平台/规则转换
* text=auto

# Windows 批处理必须是 CRLF，否则 cmd 解析可能异常
*.cmd text eol=crlf
*.bat text eol=crlf

# shell 脚本必须是 LF，否则 Linux / macOS 上报 bad interpreter
*.sh text eol=lf

# 二进制文件不做任何转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
*.mp4  binary
*.zip  binary
